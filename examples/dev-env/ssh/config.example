# Append to ~/.ssh/config. VS Code Remote-SSH and the JetBrains Toolbox App both use it.
# Your OS Login username is your email with . and @ replaced by _, for example
# alex_example_com. Replace the project, region, and zone placeholders.

# Your Cloud Workstation. Start the tunnel first, and leave it running:
#   gcloud workstations start-tcp-tunnel --project=your-dev-project \
#     --region=us-central1 --cluster=dev --config=dev <your-workstation> 22 \
#     --local-host-port=localhost:2222
Host workstation
  HostName localhost
  Port 2222
  User user
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null

# Research VMs, reached through Identity-Aware Proxy. No external IP needed.
Host research-*
  User alex_example_com
  IdentityFile ~/.ssh/google_compute_engine
  ProxyCommand gcloud compute start-iap-tunnel %h 22 --listen-on-stdin --project=your-dev-project --zone=us-central1-a --verbosity=warning
  StrictHostKeyChecking accept-new
