# Project tasks. Run `just` to list them.

default:
    @just --list

# Install the environment from the lockfile
sync:
    uv sync --locked --all-extras

# Run the tests
test:
    uv run --extra serve pytest

# Lint and check formatting
lint:
    uv run ruff check .
    uv run ruff format --check .

# Fail if any notebook still has outputs
notebooks:
    find notebooks -name '*.ipynb' -print0 | xargs -0 -r uv run nbstripout --verify

# Everything CI checks before a release
check: lint notebooks test

# Train on a workstation against your dev dataset; saves to your governed folder
train version="dev":
    uv run --env-file .env --all-extras example-model train --model-version {{version}}

# Install the git hooks
hooks:
    uv run pre-commit install
