# Copy to .env. Read by example_model.config.Settings, by `uv run --env-file .env`,
# and by VS Code and PyCharm run configurations. Never put secrets here: code that
# needs one reads it from the secret manager.
EXAMPLE_MODEL_GCP_PROJECT=your-dev-project
EXAMPLE_MODEL_REGION=us-central1
# Your governed folder in the dev bucket, never a local path for real data.
EXAMPLE_MODEL_MODEL_BUCKET=gs://your-dev-bucket/users/you/models
# Fixtures go to the team folder, readable by production training.
EXAMPLE_MODEL_FIXTURE_BUCKET=gs://your-dev-bucket/team/fixtures
# The team MLflow server. Empty turns tracking off, and the gate then fails.
EXAMPLE_MODEL_TRACKING_URI=https://mlflow.example.com
# One experiment per model; defaults to the model name.
EXAMPLE_MODEL_EXPERIMENT=
# Monitoring, production only. Tables live in the prod project.
# EXAMPLE_MODEL_PREDICTIONS_TABLE=model_monitoring.predictions
# EXAMPLE_MODEL_LABELS_TABLE=model_monitoring.labels
# EXAMPLE_MODEL_REPORTS_BUCKET=gs://your-prod-reports
